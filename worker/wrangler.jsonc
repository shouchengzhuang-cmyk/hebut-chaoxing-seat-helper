{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chaoxing-seat-reserver",
  "main": "src/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-09-21",
  "triggers": {
    "crons": ["29 14 * * *"]
  },
  "vars": {
    "ROOM_ID": "3747",
    "SEAT_NUM": "216",
    "START_TIME": "08:30",
    "END_TIME": "22:00"
  }
}
