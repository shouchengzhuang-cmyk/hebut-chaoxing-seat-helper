{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chaoxing-seat-reserver",
  "main": "src/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-09-21",
  "triggers": {
    "crons": ["29 14 * * *", "*/1 * * * *"]
  },
  "durable_objects": { "bindings": [{ "name": "SEAT_ACCOUNT", "class_name": "SeatAccount" }] },
  "migrations": [{ "tag": "v1-seat-account", "new_sqlite_classes": ["SeatAccount"] }],
  "vars": {
    "WRITES_ENABLED": "false",
    "MONITOR_ENABLED": "false",
    "AUTO_REBOOK_ENABLED": "false",
    "REBOOK_RULES_VERIFIED": "false",
    "STATUS_PROFILE_VERIFIED": "false",
    "API_STYLE": "seat",
    "POLL_SECONDS": "60",
    "ROOM_ID": "3747",
    "SEAT_NUM": "216",
    "START_TIME": "08:30",
    "END_TIME": "22:00"
  }
}
