{
  "name": "chaoxing-seat-reserver-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single-seat Chaoxing reservation Worker",
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run test:runtime",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir .build",
    "test:runtime": "npm run build && node --test test/runtime.test.mjs",
    "check:contract": "node scripts/check-contract.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.38.0",
    "miniflare": "5.20260918.0-alpha"
  },
  "engines": {
    "node": ">=22.6"
  }
}
